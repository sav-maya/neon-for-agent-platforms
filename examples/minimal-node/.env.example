# Variable reference: ./README.md
#
# Neon pooled connection string (host usually contains "-pooler")
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon API key (for provision.mjs)
NEON_API_KEY=napi_...

# Neon organization ID (required when using a personal API key)
NEON_ORG_ID=org-...
