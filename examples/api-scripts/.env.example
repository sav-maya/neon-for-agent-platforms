# Required for all scripts
NEON_API_KEY=napi_...

# create-project.mjs — optional; personal keys often need an org
NEON_ORG_ID=org-...
NEON_PROJECT_NAME=my-tenant-name

# delete-project.mjs, branch.mjs, snapshot.mjs
NEON_PROJECT_ID=proj-...

# branch.mjs create — optional override (defaults to main / production branch id)
# NEON_PARENT_BRANCH_ID=br-...

# snapshot.mjs — optional label
# NEON_SNAPSHOT_NAME=before-migration

# transfer-project.mjs — personal key; Admin on source org, Member+ on destination
NEON_SOURCE_ORG_ID=org-free-...
NEON_DESTINATION_ORG_ID=org-paid-...
# One id or comma-separated
NEON_PROJECT_IDS=proj-...

# consumption-query.mjs — usage-based metrics (v2)
# CONSUMPTION_FROM=2026-02-01T00:00:00Z
# CONSUMPTION_TO=2026-02-07T00:00:00Z
# CONSUMPTION_GRANULARITY=daily
# CONSUMPTION_METRICS=compute_unit_seconds,root_branch_bytes_month
# CONSUMPTION_PROJECT_IDS=proj-...
# CONSUMPTION_LIMIT=10
# CONSUMPTION_CURSOR=

# auth-users.mjs — Neon Auth app users (enable Auth on branch first; see auth-users.mjs meta)
# NEON_PROJECT_ID=proj-...
# NEON_BRANCH_ID=br-...
# USER_EMAIL=dev@example.com
# USER_NAME=Dev User
# AUTH_USER_ID=  # for delete
