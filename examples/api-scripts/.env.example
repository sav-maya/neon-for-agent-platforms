# Which script uses what: see ./README.md (tables + flows).
#
# Required for all scripts
NEON_API_KEY=napi_...

# Fleet / two-org layout — see ../FLEET_AND_ORG_LAYOUT.md
# Use NEON_ORG_ID for the pool you're provisioning into (free vs paid org).
# Optional: maintain separate env files or secrets per org (NEON_ORG_ID_FREE / PAID in your worker).

# create-project.ts — optional; personal keys often need an org
NEON_ORG_ID=org-...
NEON_PROJECT_NAME=my-tenant-name

# create-project-with-auth.ts — optional non-default DB for Auth tables on the branch
# NEON_AUTH_DATABASE_NAME=mydb

# delete-project.ts, branch.ts, snapshot.ts
NEON_PROJECT_ID=proj-...

# branch.ts create — optional override (defaults to main / production branch id)
# NEON_PARENT_BRANCH_ID=br-...

# snapshot.ts — optional label, auto-expiry, or LSN (not both timestamp and lsn)
# NEON_SNAPSHOT_NAME=before-migration
# NEON_SNAPSHOT_EXPIRES_AT=2026-12-31T23:59:59Z
# NEON_SNAPSHOT_LSN=0/12345678

# list-snapshots.ts, delete-snapshot.ts, rename-snapshot.ts
# (NEON_SNAPSHOT_ID for delete / rename)

# delete-branch.ts — e.g. main (old) after finalize_restore
# NEON_BRANCH_ID=br-...

# promote-safe-production.ts — https://neon.com/blog/promoting-postgres-changes-safely-production
# NEON_PROD_BRANCH_ID=br-...   # optional; defaults to main/production
# NEON_DEV_BRANCH_ID=br-...    # promote, refresh-dev
# NEON_BOOTSTRAP_DEV_BRANCH_NAME=dev
# NEON_SNAPSHOT_BOOTSTRAP_NAME=...
# NEON_SNAPSHOT_PRE_PROMOTION_NAME=...
# NEON_SNAPSHOT_DEV_CANDIDATE_NAME=...
# NEON_SNAPSHOT_REFRESH_NAME=...
# NEON_RESTORE_BACKUP_BRANCH_NAME=...
# NEON_SNAPSHOT_NEW_NAME=renamed-checkpoint

# versioning-flow.ts — database versioning demo (see neon.com/docs/ai/ai-database-versioning)
# VERSION_BASELINE_NAME=...
# VERSION_DEMO_BRANCH_NAME=...
# DEMO_MUTATE=1   # optional: INSERT on demo branch (requires npm install in this folder)

# restore-snapshot.ts
# NEON_SNAPSHOT_ID=snap-...
# NEON_TARGET_BRANCH_ID=br-...

# transfer-project.ts — personal key; Admin on source org, Member+ on destination
NEON_SOURCE_ORG_ID=org-free-...
NEON_DESTINATION_ORG_ID=org-paid-...
# One id or comma-separated
NEON_PROJECT_IDS=proj-...

# consumption-query.ts — usage-based metrics (v2)
# CONSUMPTION_FROM=2026-02-01T00:00:00Z
# CONSUMPTION_TO=2026-02-07T00:00:00Z
# CONSUMPTION_GRANULARITY=daily
# CONSUMPTION_METRICS=compute_unit_seconds,root_branch_bytes_month
# CONSUMPTION_PROJECT_IDS=proj-...
# CONSUMPTION_LIMIT=10
# CONSUMPTION_CURSOR=

# auth-users.ts — Neon Auth app users (enable Auth on branch first; see auth-users.ts meta)
# NEON_PROJECT_ID=proj-...
# NEON_BRANCH_ID=br-...
# USER_EMAIL=dev@example.com
# USER_NAME=Dev User
# AUTH_USER_ID=  # for delete
