{
  "name": "neon-agent-platform-api-scripts",
  "private": true,
  "type": "module",
  "description": "Small Neon Console REST examples (provision, branch, snapshot, versioning, org transfer, consumption)",
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "create-project": "node dist/create-project.js",
    "create-project-with-auth": "node dist/create-project-with-auth.js",
    "delete-project": "node dist/delete-project.js",
    "branch": "node dist/branch.js",
    "snapshot": "node dist/snapshot.js",
